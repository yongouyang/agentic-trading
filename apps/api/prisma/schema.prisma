// Prisma schema — SQLite (zero-ops, personal scale; architecture §3).
// R1: store RAW OHLCV (split-adjusted as delivered — store-boundary
// invariant) plus corporate-action events; adjusted series is derived
// locally in quant-core, never persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Instrument {
  id        Int     @id @default(autoincrement())
  symbol    String  @unique // provider-native, e.g. "0005.HK", "CSPX.L", "AAPL"
  market    String // "US" | "HK"
  currency  String
  name      String?
  // CA_DEGRADED: Yahoo event amounts unusable for USD-declaring HK names
  // (architecture §4, decided 2026-09-01).
  caDegraded Boolean @default(false)
  // Which provider owns the stored series — single-source invariant
  // (phase-1-hardening-plan §A.2: rescue rewrite flips to "eastmoney";
  // any later successful Yahoo fetch flips it back to "yahoo").
  dataSource String @default("yahoo")

  bars             Bar[]
  corporateActions CorporateAction[]
}

model Bar {
  instrumentId Int
  date         String // session date YYYY-MM-DD
  open         Float?
  high         Float?
  low          Float?
  close        Float?
  volume       Float?

  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@id([instrumentId, date])
}

model CorporateAction {
  instrumentId Int
  date         String // ex-date YYYY-MM-DD
  // "DIVIDEND" | "IN_SPECIE" — no split factor is ever applied (R1).
  // IN_SPECIE rows come from the weekly F10 enrichment (eastmoney
  // RPT_HKF10_MAIN_DIVBASIC 特别分配 rows, architecture §4 2026-09-06) and
  // never feed local adjustment: Yahoo closes are already net of in-specie.
  type         String
  // Cash amount per share in `currency`. DIVIDEND writes always set it; only
  // IN_SPECIE ratio-only rows (no HKD equivalent published) get null.
  amount       Float?
  currency     String // declared currency; beware Yahoo FX-converted HK amounts
  // Audit trail for IN_SPECIE rows: raw F10 PLAN_EXPLAIN + parsed ratio.
  detail       String?

  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@id([instrumentId, date, type])
}

// Phase 1 daily screen persistence (phase-1-spec §5). One ScreenRun per market
// lane per run; warningsJson enumerates every warning (expected on edge
// names — explainable, not absent). ScreenResult.metricsJson carries all
// indicator values (Phase 4 backtests read them).
model ScreenRun {
  id              Int      @id @default(autoincrement())
  runAt           DateTime @default(now())
  market          String // "US" | "HK"
  universeSize    Int
  ok              Int
  genuinelyAbsent Int
  fetchFailed     Int
  // FETCH_FAILED > 2% of the lane's universe ⇒ degraded (phase-1-spec §5).
  degraded        Boolean
  warningsJson    String
  // Phase 4b item 3: first-failure eligibility census ({ REASON: count }), so a
  // production run can be compared against the backtest replay's census for the
  // same date. '{}' on rows written before 2026-09-11 = "not recorded".
  excludedJson    String   @default("{}")
  // The session actually screened (newest bar date seen), NOT when it ran.
  // '' = unknown (pre-2026-09-11 rows). See the migration for why the run's own
  // timestamp cannot serve: runAt and the session date differ by a day for the
  // US lane, which runs at 06:10 HKT on the previous night's close.
  sessionDate     String   @default("")

  results ScreenResult[]
}

// DataBento XNAS vendor archive (research-databento-import.md §6.5, decided
// 2026-09-05): AS-TRADED bars kept losslessly under a separate convention;
// the split registry lives alongside and adjusted series is derived on read.
// R1 is untouched — these tables never feed Instrument/Bar.
model VendorBar {
  vendor    String // 'databento-xnas'
  symbol    String // plain symbol, archive filename decoded
  date      String // session date YYYY-MM-DD (ts_event first 10 chars)
  open      Float?
  high      Float?
  low       Float?
  close     Float?
  volume    Float?
  segmentId String? // 'SYM#N' surrogate; set by segment-vendor-bars.ts

  @@id([vendor, symbol, date])
}

// Empirical symbol-identity segments (research-databento-import.md §6.8):
// ticker reuse stitches two securities into one VendorBar series; the
// post-import segmentation pass flags stitch boundaries and records one row
// per contiguous segment. Raw bars are never altered.
model VendorSegment {
  vendor    String // 'databento-xnas'
  symbol    String
  segmentId String // surrogate, e.g. 'META#1', chronological
  firstDate String // first session of the segment YYYY-MM-DD
  lastDate  String // last session of the segment YYYY-MM-DD
  evidence  String // why the boundary was flagged ('' for an unstitched single segment)

  @@id([vendor, symbol, segmentId])
}

// Split registry = Yahoo v8 events (authoritative) ∪ FAR-tier in-band
// additions (estimated); dedupe on (symbol, exDate), Yahoo wins.
model SplitEvent {
  symbol     String
  exDate     String // ex-date YYYY-MM-DD
  event      String // "FORWARD_SPLIT" | "REVERSE_SPLIT"
  ratioNew   Float
  ratioOld   Float
  factor     Float // ratioNew / ratioOld
  source     String // "yahoo" | "inband"
  confidence String // "authoritative" | "estimated"

  @@id([symbol, exDate])
}

// Listing classification from symbol-listing-exchange.csv (nasdaqtraded.txt
// join) — import-universe metadata, not the screen Instrument table.
model VendorInstrument {
  symbol          String  @id
  listingExchange String?
  type            String?
  flag            String?
  securityName    String?
}

// Per-file import journal — idempotency for import-databento.ts re-runs.
model VendorImportFile {
  vendor         String
  file           String // archive filename
  symbol         String
  sha256         String
  rows           Int
  noTradeSkipped Int
  status         String // "ok" | "sha-mismatch" | "error"
  importedAt     DateTime @default(now())

  @@id([vendor, file])
}

// Phase 2 agent pipeline (phase-2-plan.md, 2026-09-06). AgentDecision is the
// content-addressed decision log: the data snapshot travels inside the user
// prompt, so an unchanged snapshot → identical hash → $0 cached rerun.
model AgentDecision {
  id            Int      @id @default(autoincrement())
  hash          String   @unique // sha256(agent|model|promptVersion|system|user)
  agent         String // "news-analyst" | "fundamentals-analyst" | "bull" | "bear" | "verdict"
  model         String
  promptVersion String
  systemPrompt  String
  userPrompt    String
  responseText  String
  usageJson     String?
  createdAt     DateTime @default(now())
}

model DeepDiveRun {
  id           Int      @id @default(autoincrement())
  runAt        DateTime @default(now())
  market       String // "US" | "HK"
  screenRunId  Int
  topN         Int
  llmCalls     Int
  cacheHits    Int
  failed       Int
  warningsJson String
  // W2: "running" while the lane's name pool is in flight, "complete" once the
  // DeepDiveReport rows are written. Read paths filter to "complete", so a
  // crashed run can never render as a report (docs/ops-hardening-plan.md).
  status       String   @default("complete")
  // 'chain' = the scheduled pipeline; 'adhoc' = an operator run (--symbol, an
  // explicit --top, or --as-of). The dashboard shows the newest COMPLETE 'chain'
  // run, so an experiment cannot silently become the lane's view.
  source       String   @default("chain")

  reports DeepDiveReport[]
}

model DeepDiveReport {
  id                 Int      @id @default(autoincrement())
  runId              Int
  symbol             String
  status             String // "ok" | "failed:<slug>"
  verdictJson        String?
  decisionHashesJson String?

  run DeepDiveRun @relation(fields: [runId], references: [id])

  @@unique([runId, symbol])
}

model ScreenResult {
  runId       Int
  symbol      String
  rank        Int
  score       Float
  metricsJson String

  run ScreenRun @relation(fields: [runId], references: [id])

  @@id([runId, symbol])
}

// Phase 3b chat (phase-3b-plan §"Data model", 2026-09-08): persisted chat
// sessions with per-session LLM usage totals; messages keep tool provenance
// (toolName/toolArgsJson) so the transcript is reviewable. Chat LLM calls
// themselves audit to AgentDecision with agent="chat".
model ChatSession {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  title            String? // first user message, truncated
  llmCalls         Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)

  messages ChatMessage[]
}

model ChatMessage {
  id           Int      @id @default(autoincrement())
  sessionId    Int
  role         String // "user" | "assistant" | "tool"
  content      String
  toolName     String? // role="tool": which tool produced it
  toolArgsJson String?
  createdAt    DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])
}
