<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ops health (W4e, docs/ops-hardening-plan.md). Runs after both daily chains
     so the artifact and log record exist even when nobody opens the dashboard.

     Fire times are 07:15 and 17:30 HKT, i.e. after the US chain (Tue-Sat 06:10)
     and after the HK chain (Mon-Fri 16:50). launchd catches missed calendar
     jobs on wake, so a sleeping laptop delays this rather than skipping it.

     Exit 1 = at least one lane or weekly job is in ALERT; triage in the log.
     NOTE: this job is a RECORD, not the alerting mechanism — the user-facing
     signal is the dashboard health banner (GET /ops/health). A desktop
     notification was considered and explicitly declined. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agentic-trading.ops-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/yongouyang/projects/agentic-trading/scripts/ops-health.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/yongouyang/projects/agentic-trading/logs/ops-health.log</string>
  <key>StandardErrorPath</key><string>/Users/yongouyang/projects/agentic-trading/logs/ops-health.err.log</string>
</dict>
</plist>
